# Small configs read adjacent .env as data; no shell source is needed.
DEEPSEEK_API_KEY=
# Remaining variables support the legacy configs/paper.yaml template.
# setup creates fresh environments; it never modifies an existing environment.
VIDUEU_PYTHON=./environments/pipeline/bin/python
VIDUEU_VLLM_PYTHON=./environments/vllm/bin/python
VIDUEU_TOOL_PYTHON=./environments/omniparser/bin/python
VIDUEU_BAGEL_PYTHON=./environments/bagel/bin/python
VIDUEU_MODEL_ROOT=./model
VIDUEU_WHISPER_MODEL=./model/whisper-large-v2
VIDUEU_CLIP_MODEL=./model/clip-vit-large-patch14
VIDUEU_BLIP_MODEL=./model/blip2-opt-2.7b
VIDUEU_OCR_DET=./model/PP-OCRv5_server_det
VIDUEU_OCR_REC=./model/PP-OCRv5_server_rec
VIDUEU_YOLO_WEIGHTS=./model/yolo/yolov8m.pt
VIDUEU_RAFT_ROOT=./model/RAFT
VIDUEU_OMNIPARSER_ROOT=./model/OmniParser
VIDUEU_FLORENCE_ROOT=./model/Florence-2-base
VIDUEU_QWEN_MODEL=./model/Qwen3.5-9B
VIDUEU_WORK_ROOT=./outputs
VIDUEU_OUTPUT_ROOT=./outputs/my_first_run
VIDUEU_INPUT=./data/my_videos
# Pick a model actually available at your provider. API calls have a cost.
VIDUEU_LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY_FILE=./secrets/deepseek.key
# An external OpenAI-compatible vision server or start_vllm.sh below.
VIDUEU_VLM_BASE_URL=http://127.0.0.1:8110/v1
